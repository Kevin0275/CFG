lAchieved":5.099999904632568,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"condition_10","strName":"十项条“件”","strDescription":"只用 10 个蓝色元件通过“条件判断”关卡","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1444480/4bedc494ccf1f64f433ad69f2f9f4de4c8176981.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":3.9000000953674316,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"fast_adder","strName":"高速加法器","strDescription":"使用延迟量不高于 35 的电路通过“8 位加法器”关卡","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1444480/162518d9ae091bfb5f3f987a2e18302260731fbd.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":2,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"water_world","strName":"水世界","strDescription":"通过“水世界”关卡","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1444480/83732ebf7611d7566505151f3da0f034a7c50191.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":2,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"binary_counter","strName":"二进制计数器","strDescription":"用包含不超过 65 个基本逻辑门的电路通过“计数器”关卡","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1444480/3fa7035b9f28406f7033b7e7b124c17f4e35183a.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":1.600000023841858,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"fast_bot","strName":"小机快跑","strDescription":"用 64 字节以内的代码通过“机器赛跑”关卡","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1444480/fbad417e9e8000c7481276f9ff04c3054df34852.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":1.2999999523162842,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"helper","strName":"机器志愿者","strDescription":"完成飞船上的所有 4 个任务请求","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1444480/2f3853727b16a49a5e38cbe3d9c77f63db1af7a3.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":1.100000023841858,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":15,"nAchieved":0}}],["achievementmap",{"version":5,"data":"[]"}],["usernews",{"version":5,"data":["COoHEIbK8L0GGUGpUwIAAHABIWqkQgQBABABKYAKFgAAAAAAUWMJgJvrXQoHYIztlL4GcIbK8L0G"]}],["gameactivity",{"version":5,"data":[]}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"LevelHead","strURL":null}],"rgPublishers":[{"strName":"LevelHead","strURL":null}],"rgFranchises":[]}}],["descriptions",{"version":1,"data":{"strFullDescription":"[h2][b]-= 你能学到什么 =-[/b][/h2]\r\n\r\n\r\n计算机里所有的电子元件都可以基于一种叫做“与非门”（NAND gate）的基本元件而实现。在本游戏中，你将会面对一系列挑战，在求解谜题的过程中，走出从基础逻辑门通向算术单元、存储器等复杂元件的道路，并沿着这条道路最终学习如何搭建完整的处理器架构。完成所有主线关卡后，你将对处理器架构、汇编语言和电子元件彼此之间的具体联系产生更加深刻的理解。你也会了解高级编程语言中常见的条件判断、循环、函数等概念是如何在汇编和硬件层面具体实现的。\r\n\r\n\r\n [img]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1444480/extras/layers_zh_CN.png?t=1740369335[/img]\r\n\r\n\r\n[h2][b]-= 你能构建什么 =-[/b][/h2]\r\n\r\n\r\n本游戏是基于一个强大的电路模拟器而开发的。这个电路模拟器允许你自由发挥想象力，以不同的解法通过各个关卡，或以自己喜欢的方式搭建属于自己的计算机。你可以随心所欲地在你的计算机上连接显示屏、计时器、声音元件等部件，也可以接收现实生活中的键盘和网络发送的数据。你甚至可以为你自己的计算机设计一套自己专属的汇编语言。\r\n\r\n[img]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1444480/extras/build_pong.png?t=1740369335[/img]","strSnippet":"通过谜题，学习处理器架构"}}]]