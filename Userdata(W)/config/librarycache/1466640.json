tps://cdn.akamai.steamstatic.com/steamcommunity/public/images/items/1466640/0eb4ced051bf7dbdbd049c1b002dade5151b4691.jpg","strMarketHash":"1466640-Alex","nOwned":0}]}}],["achievementmap",{"version":5,"data":"[]"}],["usernews",{"version":5,"data":[]}],["gameactivity",{"version":5,"data":[]}],["achievements",{"version":2,"data":{"vecHighlight":[],"vecUnachieved":[{"strID":"homesick","strName":"思乡病","strDescription":"给家里打电话","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1466640/bbbee6e6f8ccf91f450dff196041fcbf918699d1.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":49.599998474121094,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"collect","strName":"都给集齐","strDescription":"集齐录音磁带","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1466640/1eb5a83d8c9c9d343adefbb5c45b84137848fead.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":29.799999237060547,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"campaign","strName":"竞选金主","strDescription":"给弗洛雷斯或泰拉克的竞选捐赠基金会打电话并捐款","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1466640/6a414d1fa02fff94caa484dc8172c8d917fda75e.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":12.199999809265137,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":12,"nAchieved":0}}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Digixart","strURL":null}],"rgPublishers":[{"strName":"THQ Nordic","strURL":"https://store.steampowered.com/publisher/THQNordic"}],"rgFranchises":[{"strName":"Road 96","strURL":null},{"strName":"THQ Nordic","strURL":"https://store.steampowered.com/franchise/THQNordic"}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"1996年夏天，日期和今天一样。\r\n\r\n你踏上了旅途。冒险。自由。逃离。奔跑。逃离这个社会。试着活下去。\r\n\r\n在前往边界线的惊险旅途中，你将投身一场不断变化的冒险，你会遇见各种不可思议的人物，与他们产生交织与故事，并发现他们身藏的秘密。\r\n每前进一公里都会面临一个选择。你的决定会影响之后的旅程，改变你会遇到的人，甚至影响整个世界的局势。\r\n\r\n在这个名为皮特拉的独裁国家，道路有成千上万条。\r\n哪一条是你要走的呢？\r\n\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1466640/extras/1af0d5e8fd6eef2e94491c7fa035f857.poster.avif?t=1758625538\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1466640/extras/1af0d5e8fd6eef2e94491c7fa035f857.webm?t=1758625538\" width=\"600\" height=\"134\"][/imgvid]\r\n\r\n《九十六号公路》，疯狂而美丽的公路之旅。在这条独属自己的自由之路上，你会发现激动人心的地点，遇见非同寻常的人物。\r\n\r\n这场不断演化，故事驱动的冒险之旅深受昆汀·塔伦蒂诺，科恩兄弟以及奉俊昊的影视作品启发。屡获殊荣的主创团队，曾出品《勇敢的心》以及《记忆重述》。作为惠普公司 OMEN Presents 计划的一部分宣布。\r\n\r\n时而行动、时而探索、时而沉思、时而忧郁、时而处理人际交往，时而陷入怪诞场景。游戏背景则是黑暗压迫的动荡社会。\r\n\r\n惊艳的视觉风格，90年代流行风格的背景乐，上千条可选择的道路，每位玩家都可以在《九十六号公路》上创造独属自己的故事。\r\n\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1466640/extras/008f3d364d8f455486c0b5dee0100927.poster.avif?t=1758625538\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1466640/extras/008f3d364d8f455486c0b5dee0100927.webm?t=1758625538\" width=\"600\" height=\"208\"][/imgvid]","strSnippet":"知名独立游戏制作人出品，疯狂的程序生成式公路之旅，搭便车通往自由之路。每一条路都彼此不同。"}}]]