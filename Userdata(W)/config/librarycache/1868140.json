kphQIAAHABIQL3OF0BABABKWyBHAAAAAAAUUABMLDtc2IIYNeB7skGcLX76cgG"]}],["gameactivity",{"version":5,"data":[]}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"MINTROCKET","strURL":"https://store.steampowered.com/developer/mintrocket"}],"rgPublishers":[{"strName":"MINTROCKET","strURL":"https://store.steampowered.com/publisher/mintrocket"}],"rgFranchises":[]}}],["descriptions",{"version":1,"data":{"strFullDescription":"[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1868140/extras/bdd98238f8bcebd06cb8eecbf64c2dc1.poster.avif?t=1761737343\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1868140/extras/bdd98238f8bcebd06cb8eecbf64c2dc1.webm?t=1761737343\" width=\"640\" height=\"360\"][/imgvid]\r\n[h2][b]・探索神秘的蓝洞![/b][/h2]\r\n美丽的海底中充满了无数鱼种和巨大生物，\r\n对何时何地出现的海洋生物，是不是好奇呢？\r\n避开威胁生物的袭击，获得新鲜的食材。\r\n梦幻般的海洋生态和神秘的古代遗物。海里充满了谜团。\r\n\r\n\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1868140/extras/cb790d3e1fec9fd287a3fff74025efad.poster.avif?t=1761737343\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1868140/extras/cb790d3e1fec9fd287a3fff74025efad.webm?t=1761737343\" width=\"640\" height=\"360\"][/imgvid]\r\n[h2][b]・只在夜间营业的寿司店[/b][/h2]\r\n用亲自抓来的新鲜食材做出特别的寿司并销售吧！\r\n如果口碑传开，可能会有特别的客人突然来访。\r\n经营寿司店筹集资金，可以探索更深的地方！\r\n\r\n\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1868140/extras/373a574cc9347ce1dbf8749d4293a062.poster.avif?t=1761737343\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1868140/extras/373a574cc9347ce1dbf8749d4293a062.webm?t=1761737343\" width=\"640\" height=\"360\"][/imgvid]\r\n[h2][b]・在深海中存在的危险[/b][/h2]\r\n当心！异常现象导致的巨大蓝洞里有未知生命体等着您的到来。\r\n随时充分强化您的装备。对抗巨大生物，对保护自己会有很大帮助的。","strSnippet":"欢迎访问以神秘蓝洞为背景的海洋冒险游戏【潜水员戴夫 DAVE THE DIVER】。 白天在美丽的大海里打鱼，晚上经营寿司店赚钱。 伴随着个性强的同事们的故事展开的海底谜团。神秘又崭新的乐趣正在等着您！"}}]]