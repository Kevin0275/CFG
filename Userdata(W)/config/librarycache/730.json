[["achievements",{"version":2,"data":{"vecHighlight":[{"strID":"PLAY_CS2","strName":"全新的开始","strDescription":"反恐精英，再度闪耀。","bAchieved":true,"rtUnlocked":1707579670,"strImage":"https://shared.steamstatic.com/community_assets/images/apps/730/f75dd04fa12445a8ec43be65fa16ff1b8d2bf82e.jpg","bHidden":true,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0,"flAchieved":35.29999923706055}],"vecUnachieved":[],"vecAchievedHidden":[{"strID":"PLAY_CS2","strName":"全新的开始","strDescription":"反恐精英，再度闪耀。","strImage":"https://shared.steamstatic.com/community_assets/images/apps/730/f75dd04fa12445a8ec43be65fa16ff1b8d2bf82e.jpg","bAchieved":true,"rtUnlocked":1707579670,"flAchieved":0}],"nTotal":1,"nAchieved":1}}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Valve","strURL":"https://store.steampowered.com/developer/valve"}],"rgPublishers":[{"strName":"Valve","strURL":"https://store.steampowered.com/publisher/valve"}],"rgFranchises":[]}}],["descriptions",{"version":1,"data":{"strFullDescription":"二十多年来，在全球数百万玩家的共同铸就下，Counter-Strike 提供了精湛绝伦的竞技体验。而如今，CS 传奇的下一章即将揭开序幕，那就是 Counter-Strike 2。\r\n\r\nCounter-Strike 2 是 CS:GO 的免费升级版，展现了 Counter-Strike 历史上最大的技术飞跃。Counter-Strike 2 由 Source 2 引擎打造，具备基于物理的逼真渲染、最为先进的网络、经过升级的社区创意工坊工具，令人耳目一新。\r\n\r\nCounter Strike 系列于 1999 年开创了以完成目标为重的游戏玩法，而 Counter Strike 2 除了将这一经典元素保留，还会呈现以下特色：\r\n\r\n[list][*]全新 CS 综合得分与经过更新的优先权模式\r\n[*]全球及区域排行榜\r\n[*]经过升级和大改的地图\r\n[*]革命性的动态烟雾弹\r\n[*]不受刷新频率阻碍的游戏体验\r\n[*]全新设计的声画效果\r\n[*]CS:GO 的所有物品均迁移至 CS2[/list]","strSnippet":"二十多年来，在全球数百万玩家的共同铸就下，Counter-Strike 提供了精湛绝伦的竞技体验。而如今，CS 传奇的下一章即将揭开序幕，那就是 Counter-Strike 2。"}}],["badge",{"version":1,"data":{"dtNextRetry":null,"strName":"","strIconURL":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/items/730/","nLevel":0,"nMaxLevel":5,"nXP":0,"bMaxed":null,"strNextLevelName":"Chicken Chaser","nNextLevelXP":100,"rgCards":[{"strName":"Anarchist","strTitle":"无政府主义者","strImgURL":"https://community.akamai.steamstatic.com/economy/image/IzMF03bk9WpSBq-S-ekoE