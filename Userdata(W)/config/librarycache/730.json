ZQ8QVYBmD91rrFiAFqAQA=","ELOdpskGGAIgASgCMANQ8QVYBmCe/7jAiAFqAQA=","EMTfpckGGAIgASgCMARQ8QVYBmCakYa+iAFqAQA=","ELLSn8kGGAIgASgCMAJQ8QVYBmDA6c25iAFqAQA="]}],["workshop_trendy_items",{"version":2}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Valve","strURL":"https://store.steampowered.com/developer/valve"}],"rgPublishers":[{"strName":"Valve","strURL":"https://store.steampowered.com/publisher/valve"}],"rgFranchises":[]}}],["descriptions",{"version":1,"data":{"strFullDescription":"二十多年来，在全球数百万玩家的共同铸就下，Counter-Strike 提供了精湛绝伦的竞技体验。而如今，CS 传奇的下一章即将揭开序幕，那就是 Counter-Strike 2。\r\n\r\nCounter-Strike 2 是 CS:GO 的免费升级版，展现了 Counter-Strike 历史上最大的技术飞跃。Counter-Strike 2 由 Source 2 引擎打造，具备基于物理的逼真渲染、最为先进的网络、经过升级的社区创意工坊工具，令人耳目一新。\r\n\r\nCounter Strike 系列于 1999 年开创了以完成目标为重的游戏玩法，而 Counter Strike 2 除了将这一经典元素保留，还会呈现以下特色：\r\n\r\n[list][*]全新 CS 综合得分与经过更新的优先权模式\r\n[*]全球及区域排行榜\r\n[*]经过升级和大改的地图\r\n[*]革命性的动态烟雾弹\r\n[*]不受刷新频率阻碍的游戏体验\r\n[*]全新设计的声画效果\r\n[*]CS:GO 的所有物品均迁移至 CS2[/list]","strSnippet":"二十多年来，在全球数百万玩家的共同铸就下，Counter-Strike 提供了精湛绝伦的竞技体验。而如今，CS 传奇的下一章即将揭开序幕，那就是 Counter-Strike 2。"}}]]