gNwHYKmj4QPivs0XEwRuR-Od3HzkPyrOOKGSmgMDXBeSXbTQc6H-VaZG_c_WD34biREDicEu9-FQFXfqpVpGdIbMiJIVJjg5FZpHe8klZCFxspdcAbJlq9mHcQN7lwkSAUcc5QkSf2IZ3bhA5iYEBsWb-1VbuWbIGnki0nXQQnQfcMIoaXAOMZgTQ","strArtworkURL":"https://cdn.akamai.steamstatic.com/steamcommunity/public/images/items/1245620/ccff9d06a7460f8eeb2e66f69cb9ef3361abda36.jpg","strMarketHash":"1245620-Caravan","nOwned":0}]}}],["achievementmap",{"version":5,"data":"[]"}],["usernews",{"version":5,"data":["COoHENWJhMoGGQuwcQIAAHABIeEA4GwBABABKbQBEwAAAAAAUWsFIFA5dmYHYNWJhMoGcNWJhMoG"]}],["gameactivity",{"version":5,"data":[]}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"FromSoftware, Inc.","strURL":"https://store.steampowered.com/curator/45188208"}],"rgPublishers":[{"strName":"FromSoftware, Inc.","strURL":"https://store.steampowered.com/curator/45188208"},{"strName":"Bandai Namco Entertainment","strURL":"https://store.steampowered.com/publisher/BANDAINAMCO"}],"rgFranchises":[]}}],["descriptions",{"version":1,"data":{"strFullDescription":"[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1245620/extras/7055e75b2d0bfcc44f2514e9f1280021.poster.avif?t=1748630546\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1245620/extras/7055e75b2d0bfcc44f2514e9f1280021.webm?t=1748630546\" width=\"616\" height=\"260\"][/imgvid]\r\n・充满刺激的辽阔世界\r\n无缝连接的辽阔世界──尽情探索状况多变的开放场景，构造复杂、立体的巨大地下迷宫。\r\n在探索新发现时感到欣喜，在征服强敌时感到成就感十足，丰富内容等你体会。\r\n\r\n・专属于你的角色\r\n不只能自订操纵角色的外表，更能自行搭配武器、装备，与魔法──\r\n想成为力量取胜的顽强战士，或选择在魔法领域登峰造极，都能照自己的游玩风格决定。\r\n\r\n・源自神话的群像剧\r\n片段破碎，却又多彩的故事──以“交界地”为舞台登场的角色们各有主张，\r\n于是在利害关系之下谱成的群像剧，就此展开。\r\n\r\n・与其他玩家维持非即时连系的独特系统\r\n除了能与其他玩家一同游玩的多人联机游玩以外，\r\n本游戏也有非即时联机系统，能借此得知其他玩家的存在。","strSnippet":"艾尔登法环是以正统黑暗奇幻世界为舞台的动作RPG游戏。 走进辽阔的场景与地下迷宫探索未知，挑战困难重重的险境，享受克服困境时的成就感吧。 不仅如此，登场角色之间的利害关系谱成的群像剧，更是不容错过。"}}]]