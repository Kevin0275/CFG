tic.com/community_assets/images/apps/3527290/2d738f33a3d8e70ec1c5f6aa38b6dd6bc4fc1fed.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":39.20000076293945,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"PlundererBadge","strName":"盗贼奖章","strDescription":"单次探险开启 15 件行李箱。","strImage":"https://shared.steamstatic.com/community_assets/images/apps/3527290/b6712f9c8113a1a7c66ebf4c685ca41f06aab598.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":37,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"CookingBadge","strName":"烹饪奖章","strDescription":"在营火处做 20 次饭。","strImage":"https://shared.steamstatic.com/community_assets/images/apps/3527290/fea95e0fefe5fcd5517b88f29554aab4f2435e29.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":36.5,"flMinProgress":0,"flCurrentProgress":7,"flMaxProgress":20},{"strID":"PeakBadge","strName":"顶峰奖章","strDescription":"抵达顶峰。","strImage":"https://shared.steamstatic.com/community_assets/images/apps/3527290/872c6763d6463af921c3553d21e7bccba00f35d3.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":35.599998474121094,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"EmergencyPreparednessBadge","strName":"应急准备奖章","strDescription":"使用道具救治一名昏迷好友助其离死亡。","strImage":"https://shared.steamstatic.com/community_assets/images/apps/3527290/9efd678cc3413b567b9883504ca5c99588703857.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":32.599998474121094,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"NomadBadge","strName":"游牧民奖章","strDescription":"爬过方山。","strImage":"https://shared.steamstatic.com/community_assets/images/apps/3527290/8d3b6538701b338c533edd21f6f96438ccbb5e27.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":29.399999618530273,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"TriedYourBestBadge","strName":"参与奖章","strDescription":"让一名好友逃离岛屿而不带上你。","strImage":"https://shared.steamstatic.com/community_assets/images/apps/3527290/ab56546a2cfee6dfa80ec72ed2ce832cb14c3f8b.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":28.600000381469727,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":43,"nAchieved":4}}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Team PEAK","strURL":null}],"rgPublishers":[{"strName":"Aggro Crab","strURL":"https://store.steampowered.com/publisher/aggrocrab"},{"strName":"Landfall","strURL":"https://store.steampowered.com/publisher/landfallgames"}],"rgFranchises":[]}}],["descriptions",{"version":1,"data":{"strFullDescription":"[p]《PEAK》是一款需要细致合作的登山游戏，作为流落神秘岛屿的童子军探险家，无论单人独闯抑或团队协力，你们唯一获救的希望便是登上岛中那座巍峨的山峰，自然荒野险途漫漫，稍有不慎便会大难临头。顶峰在望，你有魄力能征服它吗？[/p][p]\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/e82d11d9221b2a65adeb68d8cdbc3bd2.poster.avif?t=1759172507\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/e82d11d9221b2a65adeb68d8cdbc3bd2.webm?t=1759172507\" width=\"600\" height=\"170\"][/imgvid][/p][p][b]团队协作[/b][/p][p]需要搭把手吗？和萍水相逢的朋友患难与共，无论是帮忙登上岩架，抑或是放置绳索岩钉为后来人开路，要想登上日日变换的高山，朋友们的援手是你唯一的依靠。[/p][p][/p][p][imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/846e9fa10908c6ffe7ce91c6c9e7a937.poster.avif?t=1759172507\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/846e9fa10908c6ffe7ce91c6c9e7a937.webm?t=1759172507\" width=\"600\" height=\"170\"][/imgvid][/p][p][b]攀登[/b][/p][p]大山不讲慈悲！4 种独特的生态地貌横亘在你们前往顶峰的途中，各自有着各自的危险要命套路。寻找一切可疑的食物以求果腹，小心照料身上的伤口——任何不利因素都会限制体能，令你的攀登之途更加险阻。[/p][p][/p][p][imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/5693882416756ce57898b4b2f774245d.poster.avif?t=1759172507\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/5693882416756ce57898b4b2f774245d.webm?t=1759172507\" width=\"600\" height=\"170\"][/imgvid][/p][p][b]生存[/b][/p][p]只做最坏打算：探索多种实用生存道具，能量饮料助你恢复体力，攀岩钢钉助你突破险境，更有神秘的反重绳索等你深挖妙用。唯有善用每一项优势，才能有望征服顶峰。[/p][p][/p][p][imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/d727ff6feeb578b5f07bf160882ed15f.poster.avif?t=1759172507\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/d727ff6feeb578b5f07bf160882ed15f.webm?t=1759172507\" width=\"600\" height=\"172\"][/imgvid][/p][p][/p][p][b]每天岛屿不重样[/b][/p][p]游戏地图每 24 小时轮换一次！每天都能体验新的场景布局，或者在一天内盯死同个岛屿重复挑战，直至挑战成功。[/p][p][/p][p][imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/237f4cb42de69c582fbb73ba5f8cf462.poster.avif?t=1759172507\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/237f4cb42de69c582fbb73ba5f8cf462.webm?t=1759172507\" width=\"600\" height=\"170\"][/imgvid][/p][p][b]赢取奖章[/b][/p][p]争当老练童军：赢取酷炫外观，用各色奖章向大家证明你才是真正的生存专家！[/p][p][/p][p][imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/270bbff7baa4cfb700c04a6c09085cd1.poster.avif?t=1759172507\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/270bbff7baa4cfb700c04a6c09085cd1.webm?t=1759172507\" width=\"600\" height=\"170\"][/imgvid][/p][p][b]与友共攀乐趣多[/b][/p][p]《PEAK》的多人模式仅限好友协力——邀请至多 3 名 Steam 好友一起共攀高峰吧，若是真的够胆，独闯山巅自然未尝不可！[/p][p][/p][p][imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/738321f1bc4d3b1d1dddb55463c6e2eb.poster.avif?t=1759172507\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/extras/738321f1bc4d3b1d1dddb55463c6e2eb.webm?t=1759172507\" width=\"600\" height=\"172\"][/imgvid][/p][p][/p][p][b]本作特色[/b][/p][list][*][p]4 名好友共同攀登[/p][/*][/list][list][*][p]近距聊天保持交流 [/p][/*][/list][list][*][p]4 种生态等待探索[/p][/*][*][p]各种可疑果腹食物[/p][/*][*][p]多种独特登山道具[/p][/*][*][p]围着营火烤棉花糖[/p][/*][*][p]可自定义个性角色[/p][/*][*][p]在线合作离线独闯[/p][/*][*][p]死了还能变成鬼魂[/p][/*][/list][p] [/p]","strSnippet":"《PEAK》是一款需要细致合作的登山游戏，作为流落神秘岛屿的童子军探险家，无论单人独闯抑或团队协力，你们唯一获救的希望便是登上岛中那座巍峨的山峰，自然荒野险途漫漫，稍有不慎便会大难临头。顶峰在望，你有魄力能征服它吗？"}}]]