f3554e6ca.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":26.899999618530273,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":50},{"strID":"achiv_tactical","strName":"Tactical Squad Service Medal","strDescription":"Awarded for special tactical skills (gather 3 police teams before shooting starts)","strImage":"https://shared.steamstatic.com/community_assets/images/apps/503560/da1c48aa07633a56a5f9fa514254496f3554e6ca.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":26.899999618530273,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"achiv_driving","strName":"Safe Driving Medal","strDescription":"Awarded for keeping the roads safe (Resolve 50 driving reports)","strImage":"https://shared.steamstatic.com/community_assets/images/apps/503560/da1c48aa07633a56a5f9fa514254496f3554e6ca.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":21.799999237060547,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":50},{"strID":"achiv_valor","strName":"Medal of Valor","strDescription":"Awarded for finishing 3 duties in a row without any death or major mistakes (less than -3 reputation)","strImage":"https://shared.steamstatic.com/community_assets/images/apps/503560/da1c48aa07633a56a5f9fa514254496f3554e6ca.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":20.200000762939453,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":3},{"strID":"achiv_advanced","strName":"Advanced Certification Medal","strDescription":"Awarded for reaching high experience level (any team member)","strImage":"https://shared.steamstatic.com/community_assets/images/apps/503560/da1c48aa07633a56a5f9fa514254496f3554e6ca.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":15.399999618530273,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"achiv_smile","strName":"Order of Smile","strDescription":"Awarded for a sense of humor ;)","strImage":"https://shared.steamstatic.com/community_assets/images/apps/503560/da1c48aa07633a56a5f9fa514254496f3554e6ca.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":14.399999618530273,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"achiv_meritorius","strName":"Medal of Meritorious Service","strDescription":"Awarded for long service (30 duties)","strImage":"https://shared.steamstatic.com/community_assets/images/apps/503560/da1c48aa07633a56a5f9fa514254496f3554e6ca.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":12.699999809265137,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":30},{"strID":"achiv_community","strName":"Community Policing Medal","strDescription":"Awarded for gaining 100 reputation points on one duty","strImage":"https://shared.steamstatic.com/community_assets/images/apps/503560/da1c48aa07633a56a5f9fa514254496f3554e6ca.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":12.100000381469727,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"achiv_honor","strName":"Medal of Honor","strDescription":"Awarded for finishing the campaign","strImage":"https://shared.steamstatic.com/community_assets/images/apps/503560/da1c48aa07633a56a5f9fa514254496f3554e6ca.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":9.699999809265137,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":18,"nAchieved":0}}],["workshop_trendy_items",{"version":2}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Jutsu Games","strURL":"https://store.steampowered.com/curator/33074184"}],"rgPublishers":[{"strName":"Games Operators","strURL":"https://store.steampowered.com/publisher/gameops"}],"rgFranchises":[{"strName":"Games Operators","strURL":"https://store.steampowered.com/franchise/gameops"}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"在[b]911 OPERATOR[/b]这款游戏中, 你是一名需要快速处理各种警情和险情的接警员。你不只需要接听求助电话，你还需要对险情作出适当的处理，比如提供急救指导，亦或是在需要警方/消防人员/急救人员到场处理的情况下，合理分配警力。别忘了，电话那头的可能是一位面对自己奄奄一息女儿，心急如焚的父亲，或是一名意图不明的恐怖分子，甚至也可能只是想弄个大新闻的恶作剧小鬼。急难当头，你，如何抉择？\r\n\r\n[b][h2]体验任意城市的接警员工作！*[/h2][/b]\r\n\r\n游戏中，您能玩到全世界数千个城市。自由模式中，您只需随心选择你所想玩的城市，游戏便会自动下载真实的城市数据，包括真实存在的街道、地址和救援中心。您也可以体验生涯模式，内置六座国际大城市，还有其对应的紧急事件 - 比如帮助人们在旧金山的大地震中逃难，或是帮助全华盛顿的人免于炸弹客的毒手......\r\n\r\n[b][h2]管理您的救援队伍[/h2][/b]\r\n\r\n一座城市中的警察力量，消防队和救援人员都听命于您。救援力量由丰富种类的载具（从最常见的救护车，到警方直升机......），必要的救援装备（比如防弹衣，急救箱和便携工程箱），以及能力各异的救援人员组成。\r\n \r\n[b][h2]民众的命运，掌握在您的手中！[/h2][/b]\r\n \r\n[b]游戏特色:[/b]\r\n[list][*]·游戏使用了超过50例从源于真实事件中的对话：有的严重且紧急万分，有的听上去有趣滑稽，有的也能让你心烦意乱。\r\n[*]·采用真实可行的应急救援知识。\r\n[*]·游戏支持全球所有的城市！\r\n[*]·生涯模式中有6座精心制作的城市，还有独特的事件和对话。\r\n[*]·多达140种不同类型的案件和举报。\r\n[*]·12种不同类型的载具（包括直升机，警车，摩托车等）。[/list]\r\n \r\n游戏需要网络连接以下载地图数据。完成下载后游戏支持离线运行\r\n\r\n***\r\n\r\n[i]All map data ©  OpenStreetMap authors\r\n \r\n* The term “city” is used within the meaning of OpenStreetMap service and relates to urban areas described as “city” or “town” therein.\r\nMap data derived from OpenStreetMap. All map data © OpenStreetMap contributors.[/i]","strSnippet":"911 OPERATOR 是一款模拟911接线员工作的游戏。你需要通过给予求助者现场应急指导和分配救援力量来处理各种险情。游戏中，你可以体验在任意城市中的接警员工作！"}}]]