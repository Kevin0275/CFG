steamstatic.com/steamcommunity/public/images/apps/1142710/3c41cd6374834ce704ce7155a7b2d8fb99c4da76.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":61.5,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":138,"nAchieved":0}}],["achievementmap",{"version":5,"data":"[]"}],["usernews",{"version":5,"data":["COoHEKb4kcUGGUmxXgIAAHABIVUJFloBABABKbZvEQAAAAAAUXIDcDlsbHYLYKb4kcUGcKb4kcUG","COoHEL2IiMQGGUmxXgIAAHABIVUJFloBABABKbZvEQAAAAAAUSEAYDibauYGYL2IiMQGcL2IiMQG","COoHEL3p3sMGGUmxXgIAAHABIVUJFloBABABKbZvEQAAAAAAUT8AUK0HauYGYL3p3sMGcL3p3sMG","COoHEPuOv8MGGUmxXgIAAHABIe8pMUwBABABKbZvEQAAAAAAURMTgI9MaOYGYI3p3sMGcPuOv8MG","COoHEPXXs8MGGUmxXgIAAHABIe8pMUwBABABKbZvEQAAAAAAUS4OgI9MaOYGYPXXs8MGcPXXs8MG"]}],["gameactivity",{"version":5,"data":[]}],["workshop_trendy_items",{"version":2}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"CREATIVE ASSEMBLY","strURL":null},{"strName":"Feral Interactive","strURL":null}],"rgPublishers":[{"strName":"SEGA","strURL":"https://store.steampowered.com/publisher/Sega"},{"strName":"Feral Interactive","strURL":null}],"rgFranchises":[{"strName":"Total War","strURL":"https://store.steampowered.com/franchise/TotalWar-Official"},{"strName":"Warhammer","strURL":"https://store.steampowered.com/franchise/warhammer"}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"[img width=\"616\" height=\"346\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/4399b64b745c1a2f0c3a90f5c8958dcd.avif?t=1747123128[/img]\r\n[img width=\"616\" height=\"83\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/868c3d11f98ec6a6d25501bded60d988.avif?t=1747123128[/img]\r\n垂死的神明最后一声咆哮打破了世界之间的界限，开启了通向混沌魔域的传送门。恐虐、纳垢、奸奇、色孽，这四股毁灭之力从漩涡之中涌现了出来，它们四处散布着黑暗与绝望。\r\n\r\n基斯里夫坚毅的勇士和幅员辽阔的震旦天朝就在风口浪尖之上，而一位恶魔亲王正在寻仇，他发誓要消灭那些腐蚀他的人。即将到来的风波将会吞噬一切。你会征服你的恶魔，还是让它们听令于你？ \r\n[img width=\"616\" height=\"83\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/cb704e9e94a3a9f82c2795fa3a47d53c.avif?t=1747123128[/img]\r\n你可以控制七个各具特色的种族以及数百种部队来打造一支军队，在那令人叹为观止的壮观世界里，纵横于史诗般的即时战斗之中。\r\n[img width=\"616\" height=\"344\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/53594a7d48dcf7a7ec302bb0addd31d1.avif?t=1747123128[/img]\r\n[img width=\"616\" height=\"83\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/f7005d773cb763558e117e4495dcca65.avif?t=1747123128[/img]\r\n这是迄今为止最具雄心也是最具新意的《Total War》游戏，那引人入胜的叙事将让你代入到游戏之中，这会让你进入魔幻的混沌魔域之中，然后再回到凡世之中。在战略沙盒之中打造你的帝国，这沙盒之中每一场战役都是独一无二的。\r\n[img width=\"616\" height=\"344\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/0d04020f1bac73bca6cdb2710c63d3f0.avif?t=1747123128[/img]\r\n[img width=\"616\" height=\"83\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/ca096cd20c8595f5e46d8c5e391f0cc5.avif?t=1747123128[/img]\r\n有10位传奇领主可供扮演！你会选择站在混沌诸神的一边进行他们的恶魔战役，还是选择扮演震旦天朝的远古化形神龙？是与冰雪女王一起守护基斯里夫的冰封国度，还是扮演恶魔亲王来成为终极反派？\r\n[img width=\"616\" height=\"344\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/0e90bfa944229bb57cd64e99e3720ecf.avif?t=1747123128[/img]\r\n[img width=\"616\" height=\"83\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/953e6a3b797e02253b64bab09565aab4.avif?t=1747123128[/img]\r\n用海量的身体部件和力量定制你独一无二的恶魔亲王，你有无数种潜在的组合方式来配合你自己的游戏风格\r\n[img width=\"616\" height=\"344\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/694fe09d6942684f8f104b301ed29250.avif?t=1747123128[/img]\r\n[img width=\"616\" height=\"83\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/ad9631a5859bf15fa8b691a1bd7b3232.avif?t=1747123128[/img]\r\n多人游戏的规模现在比以往更加庞大。混沌魔域的宏大多人战役可容纳8名玩家，还有紧张刺激的一对一君临模式，以基斯里夫和震旦为基础的剧情多人战役，还有排名与自定义战斗等等，想要与朋友来几场大混战，办法有的是。\r\n[img width=\"616\" height=\"344\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1142710/extras/344243864c93aecc3521c90c0528c6da.avif?t=1747123128[/img]","strSnippet":"《Total War: WARHAMMER》三部曲的终末已经到来。集结你的军力，踏入混沌魔域！在这个变幻莫测的恐怖维度中，世界的命运将尘埃落定。于是你会诛灭那些恶魔…还是转而驾驭他们呢？"}}],["badge",{"version":1,"data":{"dtNextRetry":null,"strName":"","strIconURL":"https://cdn.fastly.steamstatic.com/steamcommunity/public/images/items/1142710/","nLevel":0,"nMaxLevel":5,"nXP":0,"bMaxed":null,"strNextLevelName":"CULTIST","nNextLevelXP":100,"rgCards":[{"strName":"The Red Tzar","strTitle":"The Red Tzar","strImgURL":"https://community.fastly.steamstatic.com/economy/image/IzMF03bk9WpSBq-S-ekoE33L-iLqGFHVaU25ZzQNQcXdA3g5gMEPvUZZEfSMJ6dESN8p_2SVTY7V2NgOwHELmT4QPivs0XEwUe1pc_nDxE7Pu-OfWn36aTDBcnXYHVoxG-ZeNm6I-jSnt7_HQT3PFbwlR1oGeasF920fbMGKahs_0dMVu2u_0UZyDBItYPpPfQ68zylBYb50mnVFJ88AmHGhIpXcgQ42YRI_C7-yXu2QOYD0wS8nXBg1TvMfesvL7zOq9ZV99GOYhA","strArtworkURL":"https://cdn.fastly.steamstatic.com/steamcommunity/public/images/items/1142710/ebf22e04609548bd865738596da04b865e6af61c.jpg","strMarketHash":"1142710-The Red Tzar","nOwned":0},{"strName":"The Ice Queen","strTitle":"The Ice Queen","strImgURL":"https://community.fastly.steamstatic.com/economy/image/IzMF03bk9WpSBq-S-ekoE33L-iLqGFHVaU25ZzQNQcXdA3g5gMEPvUZZEfSMJ6dESN8p_2SVTY7V2NgOwHELmT4QPivs0XEwUe1pc-LFxU7KtOeIEjL-ZTbDKnyJT1s4GeUMPGiP-2GitujFSzvNQespQF8HdfBVoGJPaJ_cORQ8go8L5XW2kAJ_EQQsd9d5eQK6zXFOY-0mmXNGcskGyyWld5DYgFszPE8-D-ngA7STPdekwX4kXhtlTfFJYZXV5nL6vprzg5n0gmg","strArtworkURL":"https://cdn.fastly.steamstatic.com/steamcommunity/public/images/items/1142710/95473bb2e077d5fe648cfa7eaa638cf4d4046048.jpg","strMarketHash":"1142710-The Ice Queen","nOwned":0},{"strName":"The Supreme Patriarch","strTitle":"The Supreme Patriarch","strImgURL":"https://community.fastly.steamstatic.com/economy/image/IzMF03bk9WpSBq-S-ekoE33L-iLqGFHVaU25ZzQNQcXdA3g5gMEPvUZZEfSMJ6dESN8p_2SVTY7V2NgOwHELmT4QPivs0XEwUe1pc_jT0Bf-rOfGLHXjej7FPSLRWldlHOQLODrZ-mKssOiTQDybReF5Fg5QL6AApDIaP5_YOxo8h4MLrmDowUAkThBmYstBNg202HAWI4IsxSAVIJZQmXfxJJDe1wswaRM7XrniUu2WZtXw