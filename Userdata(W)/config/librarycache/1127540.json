a72e8210414152eab08ebfb4f.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":43.900001525878906,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"ACHIEVE_BATTLE_CORN_L","strName":"堕落的圣兽","strDescription":"达成杰诺独角兽的坏结局","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1127540/2809bd454d1776bc2b81862d6bd58445799bcb2b.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":43.79999923706055,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"ACHIEVE_BATTLE_HYDRA_L","strName":"无限再生","strDescription":"达成杰诺海德拉的坏结局","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1127540/39ec70650885aa86507694e9c83f10e95cbfd34d.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":40.29999923706055,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"ACHIEVE_BATTLE_DRAGON_W","strName":"风刃屠龙","strDescription":"击败杰诺龙","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1127540/58f14599d4af5498f66bff35fe530c2d61fe233b.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":39.5,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"ACHIEVE_BATTLE_DRAGON_L","strName":"灼热的巢穴","strDescription":"达成杰诺龙的坏结局","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1127540/de88068345f7731f98f935187abd5590fc63a8e2.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":38.900001525878906,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"ACHIEVE_BATTLE_ARMOR_W","strName":"守护之人","strDescription":"击败杰诺铠甲","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1127540/c0d03a09cb925529e53dc6176c68713ee4dedbd5.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":37.79999923706055,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"ACHIEVE_BATTLE_ARMOR_L","strName":"身不由己的牢笼","strDescription":"达成杰诺铠甲的坏结局","strImage":"https://shared.steamstatic.com/community_assets/images/apps/1127540/ef5792a4e1d1b215fe393acbe0682df8264ab7fc.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":35.900001525878906,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":22,"nAchieved":0}}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Waffle","strURL":null}],"rgPublishers":[{"strName":"Shiravune","strURL":"https://store.steampowered.com/publisher/shiravune"}],"rgFranchises":[{"strName":"Shiravune","strURL":"https://store.steampowered.com/franchise/shiravune"}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"《伊甸骑士 淫悦的圣魔骑士露西菲尔篇》是由Waffle开发的一部中世纪黑暗情色奇幻视觉小说。\r\n\r\n[h2]特点[/h2]\r\n[list][*]玩家的选择将左右女主角们的结局\r\n[*]与各种各样的可怕魔物奋战到底，否则会被吞噬\r\n[*]杰诺阿拉克涅和多佩尔简格的两个支线故事中有更多的附加内容\r\n[*]知名绘师Q-Gaku与Mogudan的精美画作[/list]\r\n\r\n[h2]故事[/h2]\r\n艾尔亚兰德圣王国遭遇了前所未有的危机。\r\n黑暗势力杰诺拜度试图染指王国代代相传的“神树赛菲罗斯”的力量，和平的日子在战火中逝去。\r\n幸亏有勇敢的骑士诺耶茵带领强大的圣骑士团对抗敌人，人们才得以获得片刻的安宁。\r\n但是圣骑士团被派去阻止一场精心设计的入侵，邪恶之徒对防守薄弱的圣都伸出了魔爪。\r\n\r\n善良的巫女公主赛西莉痛恨自己无力对抗淫魔。\r\n直到一个机会出现在她的面前──那是神的慈悲吗？抑或是恶魔的诱惑？\r\n“神树赛菲罗斯”赐予赛西莉禁忌的力量，使她能变身为乐园骑士──“伊甸骑士”。\r\n这是能与淫魔对抗的强大力量，但也是侵蚀赛西莉身心的双刃剑。\r\n\r\n赛西莉变身为伊甸骑士露西菲尔，挺身而出与杰诺拜度一战。\r\n但是这也代表着她更容易被自己变得淫乱的肉体摆布。她成为了淫魔们的目标，成千上万的敌人对她体内的力量虎视眈眈……","strSnippet":"善良的公主与她的女骑士挺身而出对抗淫魔，但这条道路使得她们落入羞耻与欲望的深渊……这是一部黑暗情色的奇幻视觉小说。"}}]]