ared.steamstatic.com/community_assets/images/apps/990080/e603fa6f52e5e984d35c0e0897ecda198505b193.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":27.200000762939453,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"PFA_25","strName":"问题的根源","strDescription":"使用曼德拉草击晕10个不同的敌人","strImage":"https://shared.steamstatic.com/community_assets/images/apps/990080/ca5fb8d5e0612f69a5649a9f9be0ec8903181635.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":22.600000381469727,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"PFA_29","strName":"魔咒不过三","strDescription":"强化一件装备达3次","strImage":"https://shared.steamstatic.com/community_assets/images/apps/990080/debb35fb04fb5f7bdfd112ff7f01cef57542f796.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":20,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"PFA_41","strName":"悄然无声","strDescription":"使用“统统石化”总计击败50个敌人","strImage":"https://shared.steamstatic.com/community_assets/images/apps/990080/ec2dd8ba97d767d4a3d7b4a2e7b9bdef7f13e30f.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":19.100000381469727,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"PFA_27","strName":"魔药通","strDescription":"调制每一种魔药","strImage":"https://shared.steamstatic.com/community_assets/images/apps/990080/af311def0e66409bab459dc80817539ed449fe7d.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":18.399999618530273,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"PFA_28","strName":"种下希望","strDescription":"种植每一种植物","strImage":"https://shared.steamstatic.com/community_assets/images/apps/990080/d99243e711db381e6d32a8a2826831b703205e89.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":14.399999618530273,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"PFA_32","strName":"高处风景好","strDescription":"到达城堡最高点，校长的上层书房","strImage":"https://shared.steamstatic.com/community_assets/images/apps/990080/9ec1680a9f088cc1abc909b94ced35699a9aa1b3.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":13.300000190734863,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":45,"nAchieved":0}}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Avalanche Software","strURL":"https://store.steampowered.com/developer/WBGames"}],"rgPublishers":[{"strName":"Warner Bros. Games","strURL":"https://store.steampowered.com/publisher/WBGames"}],"rgFranchises":[{"strName":"WB Games","strURL":"https://store.steampowered.com/franchise/WBGames"}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"《霍格沃茨之遗》是一款基于《哈利·波特》系列书籍设定的开放世界动作角色扮演游戏。在旅程中，你将造访那些熟悉的和陌生的地点，发现奇妙的野兽，自定义你的角色并制造魔药，掌握施放咒语的技巧，升级天赋并成为你所向往的巫师。\r\n\r\n[imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/990080/extras/e3f9440a969a000172447d73c4820f9c.poster.avif?t=1765473525\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/990080/extras/e3f9440a969a000172447d73c4820f9c.webm?t=1765473525\" width=\"610\" height=\"180\"][/imgvid]\r\n\r\n体验1800年代的霍格沃茨。你将扮演一名握有古老秘密之钥匙的学生，而这个秘密可能会威胁到整个魔法世界。结识盟友、与黑巫师战斗，并最终决定魔法世界的命运。书写你的传奇。留给后人传唱。\r\n\r\n[img width=\"600\" height=\"249\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/990080/extras/aba7623f38e0e31f229d8c922d0a796a.avif?t=1765473525[/img]\r\n\r\n[img width=\"600\" height=\"80\"]https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/990080/extras/84874f0b6b2210ae4c55dff4c622717a.avif?t=1765473525[/img]\r\n\r\n内含“闹鬼的霍格莫德商店”任务，该任务将允许进入额外的地牢、店主的装饰品套装以及游戏中的霍格莫德商店。\r\n\r\n新功能包括：\r\n-拍照模式\r\n-天赋重置 \r\n\r\n全新装饰品现可供所有玩家使用：幸存者眼镜、阿兹卡班囚服和外套、玛瑙鹰马翼兽坐骑、福灵剂魔药配方、黑巫师扫帚（2）","strSnippet":"《霍格沃茨之遗》是一款沉浸式开放世界动作角色扮演游戏。这回，你将在魔法世界中扮演“你自己”，亲手书写属于自己的传奇。"}}]]