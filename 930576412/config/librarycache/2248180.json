ps/2248180/8e70ddef8c8bbcba012c537f463a05ab56ef4fa3.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":5.599999904632568,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":20,"nAchieved":1}}],["achievementmap",{"version":5,"data":"[[2248180,[[\"Win1\",{\"strName\":\"初出茅庐\",\"strDescription\":\"获得首场胜利\",\"strImage\":\"https://cdn.steamstatic.com/steamcommunity/public/images/apps/2248180/5dfa4efd2f581d08e92b8d3abdefa8ab8c73f0c8.jpg\",\"flAchieved\":85.0999984741211,\"strID\":\"Win1\"}]]]]"}],["usernews",{"version":5,"data":["CAIQkbakvgYZHHh3NwEAEAEhAAAAAAAAAAAp9E0iAAAAAABCBFdpbjE="]}],["gameactivity",{"version":5,"data":[]}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Studio Amateur","strURL":null}],"rgPublishers":[{"strName":"Studio Amateur","strURL":null}],"rgFranchises":[]}}],["descriptions",{"version":1,"data":{"strFullDescription":"QQ讨论群: 730196408\r\n\r\n作为世界三大棋类游戏之一，中国象棋是用红黑二色圆形棋子，在方形棋盘上对弈。她模拟了古代两军对垒，在变化的局势中，调兵遣将，创造并利用一切条件，擒获对方的将帅，取得最终胜利。\r\n\r\n[h2]游戏特色[/h2]\r\n[list]\r\n[*]丰富的生涯模式，包含大型锦标赛，单人/团体赛，奖金池和其他不同玩法\r\n[*]逼真的4K视觉盛宴\r\n[*]十余种不同材质的棋子\r\n[*]详尽的有声教程，助力新手体验游戏乐趣\r\n[*]适合初学者和高级玩家的 AI难度级别\r\n[*]中局、残局、名局续下\r\n[*]本地和在线游戏模式自由切换\r\n[*]内置历史著名棋局\r\n[*]网络排位和全球排行榜\r\n[/list]","strSnippet":"这是一款画面清新的中国象棋游戏，其逼真的视觉效果，详尽的有声教程，即使是新手，也能让您乐在其中。各种精心设计的挑战，试炼您的韬略。在轻松愉悦中，助您成为一代策略大师。"}}]]