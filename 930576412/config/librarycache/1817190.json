rrentProgress":0,"flMaxProgress":0},{"strID":"fivestarreview","strName":"五星好评","strDescription":"完成所有好邻居应用任务","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1817190/cd99c545197ec17d5136863335f88ccaf9d439b4.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":37.5,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"i_monaboat","strName":"我在船上","strDescription":"乘坐南唐人街的废船","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1817190/5b41be28bd09d28dc3b3eec844dbf5ba5b8ce66b.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":36.29999923706055,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"kitbash","strName":"心灵手巧","strDescription":"制作10项升级","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1817190/5636339680825e78302a2e2e79e79ae311464b14.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":34.5,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"upandover","strName":"空中连技","strDescription":"使出毒液跳跃，再用毒液突进攻击同一名敌人","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1817190/d283a5c442eb3fbbb67bdf79e1f9acf0ef9f68d9.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":32,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"urbanexplorers","strName":"城市探险家","strDescription":"收集所有的时间胶囊","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1817190/a6b32bac60f350f879a6ce0dbc5e9066882b6204.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":32,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0},{"strID":"memorylane","strName":"回忆之路","strDescription":"收集所有的明信片","strImage":"https://cdn.steamstatic.com/steamcommunity/public/images/apps/1817190/a66b9a3fa5324a7eb2d8dd030a5e62849b5e955e.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":28,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":0}],"vecAchievedHidden":[],"nTotal":50,"nAchieved":0}}],["achievementmap",{"version":5,"data":"[]"}],["usernews",{"version":5,"data":[]}],["gameactivity",{"version":5,"data":[]}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Insomniac Games","strURL":"https://store.steampowered.com/curator/42527123"},{"strName":"Nixxes Software","strURL":"https://store.steampowered.com/developer/playstationstudios"}],"rgPublishers":[{"strName":"PlayStation Publishing LLC","strURL":"https://store.steampowered.com/publisher/playstationstudios"}],"rgFranchises":[{"strName":"Marvel's Spider-Man","strURL":"https://store.steampowered.com/curator/45312323"}]}}],["descriptions",{"version":1,"data":{"strFullDescription":"在《漫威蜘蛛侠》重制版发生的事件过后，少年迈尔斯·墨拉莱斯一边努力适应新家的生活，一边追随导师彼得·帕克的脚步，成为新一代的蜘蛛侠。然而，当一场激烈的权力斗争威胁到他的新家园时，这名充满抱负的英雄明白了“能力越强，责任越大”的道理。为了拯救漫威宇宙的纽约市，迈尔斯必须继承蜘蛛侠的衣钵，扛下这个重责大任。\r\n\r\n[b]迈尔斯·墨拉莱斯的崛起[/b]\r\n\r\n迈尔斯·墨拉莱斯发现自己拥有与导师彼得·帕克截然不同的惊人能力。驾驭他独一无二的生物电毒液轰炸攻击与隐形能力，同时将强大的蛛丝摆荡特技、装置和技能运用得淋漓尽致。\r\n\r\n[b]争权之战[/b]\r\n\r\n邪恶的能源公司与高科技犯罪大军为了争夺漫威宇宙纽约市的掌控权，掀起一场腥风血雨的战争。眼见自己的新家园沦为战场，迈尔斯必须明白成为英雄应付出的代价，并为成就大局作出牺牲。 \r\n\r\n[b]焕发生机的新家园[/b]\r\n\r\n在迈尔斯寻找归属感的同时，于他热闹熙攘又车水马龙的新社区穿梭于白雪纷飞的街头。当个人生活与打击犯罪的英雄工作两者界线逐渐模糊之时，他也找到了自己可以信赖的对象，以及家的实感。\r\n\r\n[b]PC图形优化[/b]\r\n\r\n随心选择适用于各类设备的多种图形质量选项以及帧率解锁功能，同时支持包括NVIDIA DLSS 3和NVIDIA DLSS 2、提升图像质量的NVIDIA DLAA 和降低延时的NVIDIA Reflex。也支持AMD FSR 2.1、Intel XeSS和IGTI空间升级技术。\r\n\r\n[b]光线追踪反射和阴影*[/b]\r\n\r\n开启绝佳的光线追踪反射与光线追踪阴影选项，附带多种质量模式可供选择，让这座城市的每个角落都尽显真实细节。\r\n\r\n[b]超宽屏幕支持**[/b]\r\n\r\n支持多种屏幕分辨率配置，向您呈上漫威宇宙中纽约市的电影级视觉盛宴，支持的分辨率包含16:9、16:10、21:9、32:9和48:9。48:9分辨率兼容于使用NVIDIA Surround或AMD Eyefinity的三屏幕设置。\r\n\r\n[b]控制与自定义[/b]\r\n使用有线USB连接PlayStation DualSense™控制器，通过身临其境的触觉反馈和动态扳机效果体验蜘蛛侠飞檐走壁的畅快感受。自定义控制选项将为您提供完整的键鼠支持。\r\n\r\n[i]*需要兼容的PC\r\n**需要兼容的PC和显示器设备[/i]","strSnippet":"在《漫威蜘蛛侠》重制版发生的事件过后，少年迈尔斯·墨拉莱斯一边努力适应新家的生活，一边追随导师彼得·帕克的脚步，成为新一代的蜘蛛侠。然而，当一场激烈的权力斗争威胁到他的家园时，迈尔斯必须继承蜘蛛侠的衣钵，扛下这个重责大任。"}}]]